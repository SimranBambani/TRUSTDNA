# ─────────────────────────────────────────────────────────────────────────────
# TrustDNA — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TrustDNA
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection (used by Prisma at runtime via Supabase pgBouncer)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true

# Direct connection (used by Prisma for migrations only)
DIRECT_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=trustdna-documents

# ── JWT ───────────────────────────────────────────────────────────────────────
# Session JWT secret. Store through secret management in production.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=trustdna

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex string for AES-256 encryption of sensitive fields
ENCRYPTION_KEY=replace-with-64-hex-characters

# MFA TOTP encryption and provisioning
# Must be a random 32-byte (64 hexadecimal character) key, stored outside the database.
MFA_TOTP_ISSUER=TrustDNA
MFA_TOTP_WINDOW=1

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@trustdna.io
EMAIL_REPLY_TO=support@trustdna.io

# ── KYC Module ───────────────────────────────────────────────────────────────
# Active KYC provider: 'dev' (local dev/CI only) | 'onfido' | 'persona'
# WARNING: 'dev' adapter CANNOT be used in production (enforced at runtime)
KYC_PROVIDER=DEVELOPMENT
ALLOW_DEV_AUTH_TOKENS=false

# AES-256-GCM key for encrypting PII fields (must be 32 bytes = 64 hex chars)
# Generate: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# NEVER commit a real key to Git.
# Private Supabase storage bucket for KYC documents
# MUST be created with Public Access DISABLED
KYC_STORAGE_BUCKET=trustdna-kyc-documents

# Data retention: days to keep personal info after KYC decision (default: 365)
KYC_RETENTION_DAYS=365

# ── Onfido (required when KYC_PROVIDER=onfido) ────────────────────────────────
ONFIDO_API_TOKEN=your-onfido-api-token
ONFIDO_WEBHOOK_SECRET=your-onfido-webhook-secret
ONFIDO_BASE_URL=https://api.onfido.com/v3.6

# ── Persona (required when KYC_PROVIDER=persona) ──────────────────────────────
PERSONA_API_KEY=your-persona-api-key
PERSONA_WEBHOOK_SECRET=your-persona-webhook-secret
PERSONA_BASE_URL=https://withpersona.com/api/v1

# ── Verifiable Credential issuer keys ───────────────────────────────────────
# Ed25519 PKCS#8 private key and SubjectPublicKeyInfo public key.
# Keep the private key in a secret manager; never expose it to the browser.
VC_ISSUER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
VC_ISSUER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
VC_ISSUER_KEY_ID=issuer-key-v1
# JSON map of previous key IDs to public PEM values during rotation.
VC_ISSUER_PUBLIC_KEYS=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Optional: Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=https://[YOUR-UPSTASH-URL].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-signing-secret

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
